---
// Full-bleed highlight reel at the top of the homepage. Pulls several
// photos per non-empty discipline (round-robin across that discipline's
// sets for variety), shuffles the result, then duplicates the strip
// once for a seamless infinite loop.
//
// At speed, a short/predictable cycle reads as "the same 12 photos on
// repeat" rather than infinite, no matter how seamless the loop math
// is — so this pulls enough unique photos (PER_DISCIPLINE each) and
// shuffles the discipline order so the repeat isn't obviously patterned.
//
// Motion is hand-driven in JS (requestAnimationFrame), not a CSS
// keyframe animation: it cruises on its own, but wheel/trackpad input
// and pointer-drag add velocity on top, and a mouse-proximity "dock
// magnify" effect reacts to the hovered tile every frame. See the
// <script> below for the physics.
import { summarize, type LibraryRow, type SetSummary } from '../data/library';
import { localPhoto } from '../lib/photos';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveUrl = (p: string) => (/^https?:\/\//.test(p) ? p : `${base}${p}`);

interface Slide {
  href: string;
  thumb: string;
  disciplineLabel: string;
  setName: string;
  alt: string;
}

const PER_DISCIPLINE = 5;

// Round-robins across a discipline's sets (one row from each per pass)
// so a 5-pick favors "one from every set" over "five from the biggest set".
function pickVaried(sets: SetSummary[], n: number): LibraryRow[] {
  const picks: LibraryRow[] = [];
  const cursor = sets.map(() => 0);
  let added = true;
  while (picks.length < n && added) {
    added = false;
    for (let i = 0; i < sets.length && picks.length < n; i++) {
      if (cursor[i] < sets[i].rows.length) {
        picks.push(sets[i].rows[cursor[i]]);
        cursor[i]++;
        added = true;
      }
    }
  }
  return picks;
}

function shuffle<T>(arr: T[]): T[] {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const slides: Slide[] = [];
for (const d of summarize()) {
  if (d.frameCount === 0) continue;
  for (const row of pickVaried(d.sets, PER_DISCIPLINE)) {
    const asset = localPhoto(row.fileId);
    if (!asset) continue;
    slides.push({
      href: `${base}/work/${d.discipline.key}`,
      thumb: resolveUrl(asset.thumb),
      disciplineLabel: d.discipline.label,
      setName: row.set,
      alt: row.altText || row.title || row.fileName,
    });
  }
}
const shuffledSlides = shuffle(slides);

// Seamless loop needs the track duplicated exactly once.
const track = [...shuffledSlides, ...shuffledSlides];
// Idle cruise speed (px/s) when nobody's near it — fast and alive. It
// eases down toward a slow crawl as the cursor nears a tile, but never
// stops outright (see IDLE/BROWSE speed logic in the <script> below).
// browseSpeed in that script is a fraction of this, so bumping this one
// knob scales the whole range.
const IDLE_PX_PER_SEC = 650; // scaled down further on coarse/touch pointers in the script below
---

{
  slides.length > 0 && (
    <section class="hero-carousel" aria-label="Featured work — scroll, drag, or hover to explore; select a frame to browse that section">
      <button
        type="button"
        class="hc-toggle"
        data-hc-toggle
        aria-pressed="false"
        aria-label="Pause auto-scroll"
      >
        <span data-hc-icon aria-hidden="true">
          ❚❚
        </span>
      </button>
      <div class="hc-viewport" data-hc-viewport>
        <ul class="hc-track" data-hc-track data-hc-speed={IDLE_PX_PER_SEC}>
          {track.map((s, i) => (
            <li class="hc-tile" aria-hidden={i >= slides.length ? 'true' : undefined}>
              <a href={s.href} class="hc-tile-link" tabindex={i >= slides.length ? -1 : 0}>
                <span class="hc-tile-img-wrap" data-hc-img-wrap>
                  <img src={s.thumb} alt={s.alt} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                </span>
                <span class="hc-tile-overlay">
                  <span class="hc-tile-discipline font-display font-medium">{s.disciplineLabel}</span>
                  <span class="hc-tile-set">{s.setName} →</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<script>
  function initHeroCarousel(): void {
    document.querySelectorAll<HTMLElement>('.hero-carousel').forEach((root) => {
      if (root.dataset.hcInit) return;
      root.dataset.hcInit = 'true';

      const viewport = root.querySelector<HTMLElement>('[data-hc-viewport]');
      const track = root.querySelector<HTMLUListElement>('[data-hc-track]');
      const toggle = root.querySelector<HTMLButtonElement>('[data-hc-toggle]');
      const icon = root.querySelector<HTMLElement>('[data-hc-icon]');
      if (!viewport || !track) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) return; // CSS fallback: plain scrollable row, no JS motion.

      const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;

      const tiles = Array.from(track.querySelectorAll<HTMLLIElement>('.hc-tile'));
      const halfCount = tiles.length / 2; // track = [items, items]
      const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

      let tileLefts: number[] = [];
      let tileWidths: number[] = [];
      let halfWidth = 0;
      function measure(): void {
        tileLefts = tiles.map((t) => t.offsetLeft);
        tileWidths = tiles.map((t) => t.offsetWidth);
        halfWidth = tileLefts[halfCount] ?? track.scrollWidth / 2;
      }
      measure();
      window.addEventListener('resize', measure);

      // Fast when nobody's near it, slows to a readable crawl the closer
      // the cursor gets to a tile — never a hard stop, so it never reads
      // as "frozen". idleSpeed is configurable via the component; browseSpeed
      // is a fixed fraction of it so one knob controls the whole range.
      // Coarse/touch pointers (mobile) get a further reduction — there's no
      // hover-to-slow-down there, so the configured speed is the only pace
      // a touch user ever sees, and the full desktop pace read as too fast.
      const idleSpeed = -parseFloat(track.dataset.hcSpeed || '130') * (isCoarsePointer ? 0.45 : 1); // px/s, leftward
      const browseSpeed = idleSpeed * 0.1;
      let velocity = idleSpeed;
      let attention = 0; // 0 = idle/far, 1 = right on a tile; drives target speed
      let offset = 0; // monotonic internal position; rendered value is wrapped into [0, halfWidth)
      let userPaused = false;
      let dragging = false;
      let wasDrag = false;
      let lastTime = performance.now();

      let mouseX: number | null = null;
      let hovering = false;

      // --- Wheel / trackpad: an impulse added to velocity, which then
      // eases back toward cruise speed on its own (the "elastic settle"). ---
      function onWheel(e: WheelEvent): void {
        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        e.preventDefault();
        velocity = clamp(velocity + delta * 6, -4500, 4500);
      }
      viewport.addEventListener('wheel', onWheel, { passive: false });

      // --- Pointer drag: grab-and-fling, like a physical reel. ---
      let dragStartClientX = 0;
      let dragStartClientY = 0;
      let dragStartTime = 0;
      let dragPointerType = 'mouse';
      let dragStartOffset = 0;
      let dragSamples: { t: number; x: number }[] = [];
      let dragMoved = 0;

      // On touch, a brief brush while scrolling the page past the carousel
      // — or just lifting a finger a little off-axis — must not read as
      // "tap, navigate". Require a tighter, more deliberate gesture: total
      // movement under this, released quickly, or it's not a tap.
      const TOUCH_TAP_MAX_MOVE = 10; // px, measured in any direction
      const TOUCH_TAP_MAX_DURATION = 300; // ms

      function onPointerDown(e: PointerEvent): void {
        dragging = true;
        wasDrag = false;
        dragMoved = 0;
        // No setPointerCapture here: it would retarget the browser's native
        // click synthesis away from the <a> tile under the cursor, breaking
        // click-to-navigate. window-level pointermove/pointerup already
        // track the drag past the element's own bounds without it.
        dragStartClientX = e.clientX;
        dragStartClientY = e.clientY;
        dragStartTime = performance.now();
        dragPointerType = e.pointerType;
        dragStartOffset = offset;
        dragSamples = [{ t: performance.now(), x: e.clientX }];
        velocity = 0;
        root.classList.add('is-dragging');
      }
      function onPointerMove(e: PointerEvent): void {
        mouseX = e.clientX;
        if (!dragging) return;
        // Safety net: if the button isn't actually held anymore (release
        // happened somewhere that didn't deliver a pointerup — e.g. outside
        // the window), treat this move as the release instead of getting
        // stuck in "dragging" forever.
        if (e.buttons === 0) {
          onPointerUp();
          return;
        }
        const dx = e.clientX - dragStartClientX;
        const dy = e.clientY - dragStartClientY;
        dragMoved = Math.max(dragMoved, Math.abs(dx));
        if (dragPointerType === 'touch') {
          if (Math.hypot(dx, dy) > TOUCH_TAP_MAX_MOVE) wasDrag = true;
        } else if (dragMoved > 6) {
          wasDrag = true;
        }
        offset = dragStartOffset - dx;
        dragSamples.push({ t: performance.now(), x: e.clientX });
        if (dragSamples.length > 6) dragSamples.shift();
      }
      function onPointerUp(): void {
        if (!dragging) return;
        dragging = false;
        root.classList.remove('is-dragging');
        // A touch that lingered too long before release isn't a crisp tap
        // either, even if it barely moved — require both conditions.
        if (dragPointerType === 'touch' && performance.now() - dragStartTime > TOUCH_TAP_MAX_DURATION) {
          wasDrag = true;
        }
        if (dragSamples.length >= 2) {
          const first = dragSamples[0];
          const last = dragSamples[dragSamples.length - 1];
          const dt = (last.t - first.t) / 1000;
          if (dt > 0.01) velocity = clamp((first.x - last.x) / dt, -6000, 6000);
        }
        // Mousedown focuses the <a> under the cursor as a native side
        // effect, even when the gesture turns out to be a drag. Nothing
        // else would blur it afterward, so clear it explicitly — otherwise
        // the strip would sit at the slow "focused" speed indefinitely
        // instead of recovering to full idle speed.
        if (wasDrag && document.activeElement instanceof HTMLElement && track.contains(document.activeElement)) {
          document.activeElement.blur();
        }
      }
      track.addEventListener('pointerdown', onPointerDown);
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
      window.addEventListener('pointercancel', onPointerUp);
      // More safety nets: losing window focus or tab visibility mid-drag
      // (alt-tab, switching apps) must never leave the carousel stuck.
      window.addEventListener('blur', onPointerUp);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) onPointerUp();
      });

      // Suppress the click-through navigation if the gesture was actually a drag/fling.
      track.addEventListener(
        'click',
        (e) => {
          if (wasDrag) {
            e.preventDefault();
            e.stopPropagation();
            wasDrag = false;
          }
        },
        true,
      );

      viewport.addEventListener('mouseenter', () => {
        hovering = true;
      });
      viewport.addEventListener('mouseleave', () => {
        hovering = false;
        mouseX = null;
      });

      toggle?.addEventListener('click', () => {
        userPaused = !userPaused;
        toggle.setAttribute('aria-pressed', String(userPaused));
        toggle.setAttribute('aria-label', userPaused ? 'Resume auto-scroll' : 'Pause auto-scroll');
        if (icon) icon.textContent = userPaused ? '►' : '❚❚';
      });

      function tick(now: number): void {
        const dt = Math.min(0.05, (now - lastTime) / 1000);
        lastTime = now;

        if (!userPaused && !dragging) {
          // A keyboard-focused tile slows the strip (soft, like mouse
          // proximity) rather than hard-pausing it. A hard pause-on-focus
          // was tried and removed: dragging focuses an <a> as a native
          // side effect of mousedown, and since nothing blurs it again
          // just from moving the mouse away, that focus can persist
          // indefinitely — a hard pause gated on it froze the carousel
          // permanently after any drag. Soft slowdown has the same
          // failure mode cost it near-zero: worst case it cruises at
          // browseSpeed forever, which still visibly moves.
          const tileFocused = document.activeElement instanceof Node && track.contains(document.activeElement);
          const effectiveAttention = Math.max(attention, tileFocused ? 1 : 0);
          // Target speed: fast cruise by default, easing down toward a
          // slow (but never fully stopped) crawl the closer the cursor
          // gets to a tile. Recomputed every frame from `attention` below.
          const targetSpeed = idleSpeed + (browseSpeed - idleSpeed) * effectiveAttention;
          // Ease velocity toward that target every frame — the "speeds up
          // / slows down, then settles" feel after any wheel flick, drag
          // release, or proximity change, frame-rate independent. Tuned to
          // reach ~99% of the way back within half a second: a big flick
          // used to leave a visible mis-direction/wrong-speed excursion
          // for well over a second before it was fully gone, which read
          // as "it just spins whichever way you last left it" rather than
          // transient momentum.
          const recovery = 1 - Math.pow(0.0005, dt);
          velocity += (targetSpeed - velocity) * recovery;
          offset += velocity * dt;
        }

        if (halfWidth > 0) {
          offset = ((offset % halfWidth) + halfWidth) % halfWidth;
        }
        track.style.transform = `translate3d(${-offset}px,0,0)`;

        if (fineHover && hovering && mouseX !== null) {
          const vpRect = viewport.getBoundingClientRect();
          const localMouseX = mouseX - vpRect.left;
          const radius = 230;
          let frameAttention = 0;
          tiles.forEach((tile, i) => {
            const renderedLeft = tileLefts[i] - offset;
            const center = renderedLeft + tileWidths[i] / 2;
            const dist = Math.abs(localMouseX - center);
            const t = Math.max(0, 1 - dist / radius);
            const eased = t * t * (3 - 2 * t); // smoothstep
            frameAttention = Math.max(frameAttention, eased);
            const wrap = tile.querySelector<HTMLElement>('[data-hc-img-wrap]');
            if (wrap) {
              const tilt = clamp((localMouseX - center) / radius, -1, 1) * -eased * 5;
              wrap.style.transform = `translateY(${-eased * 10}px) scale(${1 + eased * 0.09}) rotate(${tilt}deg)`;
              wrap.style.boxShadow = `0 ${eased * 22}px ${eased * 34}px -10px rgba(0,0,0,${eased * 0.55})`;
            }
            tile.style.zIndex = eased > 0.04 ? '3' : '1';
          });
          attention = frameAttention;
        } else {
          attention = 0;
          tiles.forEach((tile) => {
            const wrap = tile.querySelector<HTMLElement>('[data-hc-img-wrap]');
            if (wrap) {
              wrap.style.transform = '';
              wrap.style.boxShadow = '';
            }
            tile.style.zIndex = '1';
          });
        }

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  }

  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>

<style>
  .hero-carousel {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
  }

  .hc-viewport {
    overflow: hidden;
    cursor: grab;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 clamp(1rem, 4vw, 4rem),
      #000 calc(100% - clamp(1rem, 4vw, 4rem)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 clamp(1rem, 4vw, 4rem),
      #000 calc(100% - clamp(1rem, 4vw, 4rem)),
      transparent 100%
    );
  }

  .hero-carousel.is-dragging .hc-viewport {
    cursor: grabbing;
  }

  .hc-track {
    display: flex;
    gap: 1rem;
    width: max-content;
    margin: 0;
    padding: 2.75rem 0;
    list-style: none;
    will-change: transform;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }

  .hc-tile {
    flex: 0 0 auto;
    width: clamp(220px, 24vw, 300px);
    aspect-ratio: 3 / 4;
    position: relative;
  }

  .hc-tile-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    cursor: pointer;
  }

  .hc-tile-img-wrap {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform-origin: 50% 85%;
    transition: transform 0.12s ease-out, box-shadow 0.12s ease-out;
    box-shadow: 0 0 0 0 transparent;
  }

  .hc-tile-link:active .hc-tile-img-wrap {
    transition: transform 0.08s ease-out;
    filter: brightness(0.92);
  }

  .hc-tile-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: none;
  }

  .hc-tile-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1rem 1rem 1.1rem;
    background: linear-gradient(to top, rgba(11, 11, 12, 0.88), transparent 70%);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transform: translateY(8px);
    opacity: 0.88;
    transition: transform 0.3s ease, opacity 0.3s ease;
    pointer-events: none;
  }

  .hc-tile-link:hover .hc-tile-overlay,
  .hc-tile-link:focus-visible .hc-tile-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .hc-tile-discipline {
    font-size: 1.05rem;
    color: var(--paper);
    letter-spacing: 0.01em;
  }

  .hc-tile-set {
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .hc-toggle {
    all: unset;
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.65rem;
    color: var(--paper);
    background: rgba(11, 11, 12, 0.55);
    cursor: pointer;
  }

  .hc-toggle:hover,
  .hc-toggle:focus-visible {
    color: var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-track {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .hc-toggle {
      display: none;
    }
  }
</style>
