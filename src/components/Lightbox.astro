---
import { localPhoto } from '../lib/photos';

interface LightboxImage {
  fileId: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: LightboxImage[];
  columns?: string;
}

const { images, columns = 'repeat(auto-fill, minmax(240px, 1fr))' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolved = images.map((img) => ({ ...img, asset: localPhoto(img.fileId) }));
const available = resolved.filter((r) => r.asset);

// Drive hotlink fallbacks are absolute URLs; local synced photos are
// root-relative paths that need the site's base path prefixed.
const resolveUrl = (p: string) => (/^https?:\/\//.test(p) ? p : `${base}${p}`);

const payload = available.map((r) => ({
  full: resolveUrl(r.asset!.full),
  alt: r.alt,
  caption: r.caption ?? '',
}));
---

<div class="frame-toggle-row">
  <label class="frame-toggle">
    <span class="frame-toggle-label">Frame</span>
    <input type="checkbox" data-frame-toggle checked aria-label="Show frame and mount around photos" />
    <span class="frame-toggle-track"><span class="frame-toggle-thumb" /></span>
  </label>
</div>

<div class="photo-grid" style={`grid-template-columns:${columns}`}>
  {
    resolved.map((r) =>
      r.asset ? (
        <button
          type="button"
          class="photo-tile"
          data-lightbox-open
          data-index={available.indexOf(r)}
          aria-label={`Open image ${available.indexOf(r) + 1} of ${available.length}: ${r.alt}`}
        >
          <span class="photo-frame">
            <img
              src={resolveUrl(r.asset.thumb)}
              alt={r.alt}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            {r.caption && <span class="photo-tile-caption">{r.caption}</span>}
          </span>
        </button>
      ) : (
        <div class="photo-tile photo-tile-pending">
          <p class="meta text-center text-muted">
            {r.alt}
            <br />
            <span class="text-signal">image pending pipeline</span>
          </p>
        </div>
      ),
    )
  }
</div>

<div class="lightbox" data-lightbox-root aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="lightbox-backdrop" data-lightbox-backdrop></div>
  <div class="lightbox-stage">
    <span class="lightbox-mount">
      <img data-lightbox-img alt="" draggable="false" />
    </span>
  </div>
  <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Next image">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <div class="lightbox-meta">
    <span class="lightbox-caption" data-lightbox-caption></span>
    <span class="lightbox-counter" data-lightbox-counter></span>
  </div>
</div>

<script type="application/json" data-lightbox-payload set:html={JSON.stringify(payload)} />

<script>
  function initLightbox(): void {
    const roots = document.querySelectorAll<HTMLElement>('[data-lightbox-root]');
    roots.forEach((root) => {
      if (root.dataset.lightboxInit) return;
      root.dataset.lightboxInit = 'true';

      const wrapper = root.parentElement;
      const payloadEl = wrapper?.querySelector<HTMLScriptElement>('[data-lightbox-payload]');
      const images: { full: string; alt: string; caption: string }[] = payloadEl
        ? JSON.parse(payloadEl.textContent || '[]')
        : [];
      const tiles = wrapper?.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]') ?? [];

      const imgEl = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const captionEl = root.querySelector<HTMLElement>('[data-lightbox-caption]');
      const counterEl = root.querySelector<HTMLElement>('[data-lightbox-counter]');
      const backdrop = root.querySelector<HTMLElement>('[data-lightbox-backdrop]');
      const closeBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-next]');
      if (!imgEl || !captionEl || !counterEl || !backdrop || !closeBtn) return;

      let currentIndex = 0;
      let lastFocused: HTMLElement | null = null;

      function preload(i: number) {
        const data = images[i];
        if (!data) return;
        const pre = new window.Image();
        pre.src = data.full;
      }

      // Crossing a set's own boundary continues into the next (or previous)
      // gallery on the page rather than just wrapping back on itself — the
      // lightbox equivalent of the page's "keep scrolling" continuation.
      function siblingRoots(): HTMLElement[] {
        return Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox-root]'));
      }

      function tryGoToNeighbor(direction: 1 | -1): boolean {
        const roots = siblingRoots();
        const idx = roots.indexOf(root);
        if (idx === -1) return false;
        const neighbor = roots[idx + direction] as
          | (HTMLElement & { __lightboxApi?: { open: (i: number) => void; imageCount: () => number } })
          | undefined;
        if (neighbor?.__lightboxApi) {
          close();
          neighbor.__lightboxApi.open(direction === 1 ? 0 : neighbor.__lightboxApi.imageCount() - 1);
          return true;
        }
        return false;
      }

      async function crossBoundary(direction: 1 | -1): Promise<boolean> {
        if (tryGoToNeighbor(direction)) return true;
        const ensureMore = (window as any).pixeljoyEnsureNextSection;
        if (direction === 1 && typeof ensureMore === 'function') {
          await ensureMore();
          if (tryGoToNeighbor(direction)) return true;
        }
        return false;
      }

      function show(i: number, skipFade = false) {
        if (images.length === 0) return;
        if (i < 0 || i >= images.length) {
          const direction: 1 | -1 = i < 0 ? -1 : 1;
          crossBoundary(direction).then((moved) => {
            if (!moved) show(((i % images.length) + images.length) % images.length, skipFade);
          });
          return;
        }
        currentIndex = i;
        const data = images[currentIndex];
        if (!imgEl || !captionEl || !counterEl) return;

        const finish = () => {
          imgEl.src = data.full;
          imgEl.alt = data.alt || '';
          captionEl.textContent = data.caption || '';
          counterEl.textContent = images.length > 1 ? `${currentIndex + 1} / ${images.length}` : '';
          requestAnimationFrame(() => imgEl.classList.remove('is-switching'));
        };

        if (skipFade) {
          finish();
        } else {
          imgEl.classList.add('is-switching');
          window.setTimeout(finish, 90);
        }
        preload(currentIndex + 1);
        preload(currentIndex - 1);
      }

      function onKeydown(e: KeyboardEvent) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(currentIndex + 1);
        else if (e.key === 'ArrowLeft') show(currentIndex - 1);
      }

      function open(i: number) {
        lastFocused = document.activeElement as HTMLElement | null;
        root.classList.add('is-open');
        root.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        show(i, true);
        closeBtn?.focus();
        document.addEventListener('keydown', onKeydown);
      }

      function close() {
        root.classList.remove('is-open');
        root.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        lastFocused?.focus();
      }

      (root as HTMLElement & { __lightboxApi?: unknown }).__lightboxApi = {
        open,
        imageCount: () => images.length,
      };

      tiles.forEach((tile) => {
        tile.addEventListener('click', () => {
          const idx = Number(tile.dataset.index ?? '0');
          open(idx);
        });
      });

      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => show(currentIndex - 1));
      nextBtn?.addEventListener('click', () => show(currentIndex + 1));
      imgEl.addEventListener('contextmenu', (e) => e.preventDefault());
      imgEl.addEventListener('dragstart', (e) => e.preventDefault());

      // Touch swipe (mobile only — desktop pointers never fire touch events).
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartTime = 0;
      const SWIPE_MIN_DISTANCE = 40;
      const SWIPE_MAX_OFF_AXIS = 75;
      const SWIPE_MAX_DURATION = 600;

      function onTouchStart(e: TouchEvent) {
        if (e.touches.length !== 1) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      }

      function onTouchEnd(e: TouchEvent) {
        if (images.length < 1 || e.changedTouches.length !== 1) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Date.now() - touchStartTime > SWIPE_MAX_DURATION) return;
        if (Math.abs(dx) < SWIPE_MIN_DISTANCE || Math.abs(dy) > SWIPE_MAX_OFF_AXIS) return;
        show(dx < 0 ? currentIndex + 1 : currentIndex - 1);
      }

      for (const el of [imgEl, backdrop]) {
        el.addEventListener('touchstart', onTouchStart, { passive: true });
        el.addEventListener('touchend', onTouchEnd, { passive: true });
      }
    });
  }

  const FRAME_STORAGE_KEY = 'pixeljoy:frames';

  function applyFrameState(on: boolean): void {
    document.documentElement.dataset.frames = on ? 'on' : 'off';
    document.querySelectorAll<HTMLInputElement>('[data-frame-toggle]').forEach((input) => {
      input.checked = on;
    });
  }

  function initFrameToggle(): void {
    const stored = window.localStorage.getItem(FRAME_STORAGE_KEY);
    applyFrameState(stored !== 'off');

    document.querySelectorAll<HTMLInputElement>('[data-frame-toggle]').forEach((input) => {
      if (input.dataset.frameToggleInit) return;
      input.dataset.frameToggleInit = 'true';
      input.addEventListener('change', () => {
        window.localStorage.setItem(FRAME_STORAGE_KEY, input.checked ? 'on' : 'off');
        applyFrameState(input.checked);
      });
    });
  }

  initLightbox();
  initFrameToggle();
  document.addEventListener('astro:page-load', () => {
    initLightbox();
    initFrameToggle();
  });
</script>

<style>
  .photo-grid {
    display: grid;
    gap: 0.75rem;
  }

  .frame-toggle-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.625rem;
  }

  .frame-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
  }

  .frame-toggle-label {
    font-size: var(--t-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.2s ease;
  }

  .frame-toggle:hover .frame-toggle-label {
    color: var(--paper);
  }

  .frame-toggle input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .frame-toggle-track {
    position: relative;
    width: 26px;
    height: 14px;
    border-radius: 999px;
    background: var(--ink-soft);
    border: 1px solid rgba(242, 240, 236, 0.18);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .frame-toggle-thumb {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .frame-toggle input:checked ~ .frame-toggle-track {
    border-color: var(--signal);
  }

  .frame-toggle input:checked ~ .frame-toggle-track .frame-toggle-thumb {
    transform: translateX(12px);
    background: var(--signal);
  }

  .frame-toggle input:focus-visible ~ .frame-toggle-track {
    outline: 1px solid var(--signal);
    outline-offset: 2px;
  }

  /* Modern flat-molding frame with a paper mat board reveal, à la a
     minimal IKEA-style frame. --frames=off (toggled by the switch above)
     strips it back to the bare photo, edge to edge. */
  .photo-tile {
    all: unset;
    cursor: zoom-in;
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    box-sizing: border-box;
    border: 3px solid var(--ink-soft);
    background: var(--paper);
    padding: 10px;
    box-shadow:
      0 16px 26px -18px rgba(0, 0, 0, 0.7),
      0 2px 5px rgba(0, 0, 0, 0.35);
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease, padding 0.35s ease;
  }

  .photo-tile:hover,
  .photo-tile:focus-visible {
    transform: translateY(-3px);
    border-color: var(--signal);
    box-shadow:
      0 26px 38px -18px rgba(0, 0, 0, 0.75),
      0 4px 10px rgba(0, 0, 0, 0.4);
  }

  :root[data-frames='off'] .photo-tile {
    border-color: transparent;
    background: none;
    padding: 0;
    box-shadow: none;
  }

  :root[data-frames='off'] .photo-tile:hover,
  :root[data-frames='off'] .photo-tile:focus-visible {
    box-shadow: none;
  }

  .photo-frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--ink-soft);
  }

  .photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    transition: transform 0.5s ease;
  }

  .photo-tile:hover img,
  .photo-tile:focus-visible img {
    transform: scale(1.04);
  }

  .photo-tile-pending {
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    box-sizing: border-box;
    background: var(--ink-soft);
    border: 1px dashed rgba(242, 240, 236, 0.14);
  }

  .photo-tile-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.5rem 0.75rem;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    color: var(--paper);
    background: linear-gradient(to top, rgba(11, 11, 12, 0.75), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .photo-tile:hover .photo-tile-caption,
  .photo-tile:focus-visible .photo-tile-caption {
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: var(--ink);
  }

  .lightbox-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 6vw, 5rem);
    pointer-events: none;
  }

  .lightbox-mount {
    --mount-border: 5px;
    --mount-pad: clamp(14px, 2vw, 24px);
    position: relative;
    display: inline-block;
    max-width: 100%;
    max-height: 100%;
    box-sizing: border-box;
    border: var(--mount-border) solid var(--ink-soft);
    background: var(--paper);
    padding: var(--mount-pad);
    box-shadow:
      0 50px 90px -30px rgba(0, 0, 0, 0.8),
      0 12px 28px rgba(0, 0, 0, 0.5);
    transition: opacity 0.18s ease, transform 0.18s ease, border-color 0.3s ease;
  }

  :root[data-frames='off'] .lightbox-mount {
    --mount-border: 0px;
    --mount-pad: 0px;
    border-color: transparent;
    background: none;
    box-shadow: none;
  }

  .lightbox-stage img {
    pointer-events: auto;
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 2 * clamp(1.5rem, 6vw, 5rem) - 2 * var(--mount-border) - 2 * var(--mount-pad));
    object-fit: contain;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .lightbox-stage img.is-switching {
    opacity: 0;
    transform: scale(0.98);
  }

  .lightbox-btn {
    all: unset;
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--paper);
    background: rgba(26, 26, 29, 0.6);
    cursor: pointer;
    z-index: 2;
  }

  .lightbox-btn:hover,
  .lightbox-btn:focus-visible {
    color: var(--signal);
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox-prev {
    top: 50%;
    left: 1rem;
    transform: translateY(-50%);
  }

  .lightbox-next {
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
  }

  .lightbox-meta {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    color: var(--muted);
    pointer-events: none;
  }

  .lightbox-caption {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .lightbox-prev,
    .lightbox-next {
      width: 3.25rem;
      height: 3.25rem;
      background: rgba(26, 26, 29, 0.75);
    }
    .lightbox-prev {
      left: 0.25rem;
    }
    .lightbox-next {
      right: 0.25rem;
    }
  }
</style>
