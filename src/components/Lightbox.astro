---
import { localPhoto } from '../lib/photos';

interface LightboxImage {
  fileId: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: LightboxImage[];
  columns?: string;
}

const { images, columns = 'repeat(auto-fill, minmax(240px, 1fr))' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const resolved = images.map((img) => ({ ...img, asset: localPhoto(img.fileId) }));
const available = resolved.filter((r) => r.asset);

const payload = available.map((r) => ({
  full: `${base}${r.asset!.full}`,
  alt: r.alt,
  caption: r.caption ?? '',
}));
---

<div class="photo-grid" style={`grid-template-columns:${columns}`}>
  {
    resolved.map((r) =>
      r.asset ? (
        <button
          type="button"
          class="photo-tile"
          data-lightbox-open
          data-index={available.indexOf(r)}
          aria-label={`Open image ${available.indexOf(r) + 1} of ${available.length}: ${r.alt}`}
        >
          <img
            src={`${base}${r.asset.thumb}`}
            alt={r.alt}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
          {r.caption && <span class="photo-tile-caption">{r.caption}</span>}
        </button>
      ) : (
        <div class="photo-tile photo-tile-pending">
          <p class="meta text-center text-muted">
            {r.alt}
            <br />
            <span class="text-signal">image pending pipeline</span>
          </p>
        </div>
      ),
    )
  }
</div>

<div class="lightbox" data-lightbox-root aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="lightbox-backdrop" data-lightbox-backdrop></div>
  <div class="lightbox-stage">
    <img data-lightbox-img alt="" draggable="false" />
  </div>
  <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>
  {
    images.length > 1 && (
      <>
        <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Previous image">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Next image">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </>
    )
  }
  <div class="lightbox-meta">
    <span class="lightbox-caption" data-lightbox-caption></span>
    <span class="lightbox-counter" data-lightbox-counter></span>
  </div>
</div>

<script type="application/json" data-lightbox-payload set:html={JSON.stringify(payload)} />

<script>
  function initLightbox(): void {
    const roots = document.querySelectorAll<HTMLElement>('[data-lightbox-root]');
    roots.forEach((root) => {
      if (root.dataset.lightboxInit) return;
      root.dataset.lightboxInit = 'true';

      const wrapper = root.parentElement;
      const payloadEl = wrapper?.querySelector<HTMLScriptElement>('[data-lightbox-payload]');
      const images: { full: string; alt: string; caption: string }[] = payloadEl
        ? JSON.parse(payloadEl.textContent || '[]')
        : [];
      const tiles = wrapper?.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]') ?? [];

      const imgEl = root.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const captionEl = root.querySelector<HTMLElement>('[data-lightbox-caption]');
      const counterEl = root.querySelector<HTMLElement>('[data-lightbox-counter]');
      const backdrop = root.querySelector<HTMLElement>('[data-lightbox-backdrop]');
      const closeBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-close]');
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-lightbox-next]');
      if (!imgEl || !captionEl || !counterEl || !backdrop || !closeBtn) return;

      let currentIndex = 0;
      let lastFocused: HTMLElement | null = null;

      function preload(i: number) {
        const data = images[i];
        if (!data) return;
        const pre = new window.Image();
        pre.src = data.full;
      }

      function show(i: number, skipFade = false) {
        if (images.length === 0) return;
        currentIndex = (i + images.length) % images.length;
        const data = images[currentIndex];
        if (!imgEl || !captionEl || !counterEl) return;

        const finish = () => {
          imgEl.src = data.full;
          imgEl.alt = data.alt || '';
          captionEl.textContent = data.caption || '';
          counterEl.textContent = images.length > 1 ? `${currentIndex + 1} / ${images.length}` : '';
          requestAnimationFrame(() => imgEl.classList.remove('is-switching'));
        };

        if (skipFade) {
          finish();
        } else {
          imgEl.classList.add('is-switching');
          window.setTimeout(finish, 90);
        }
        preload(currentIndex + 1);
        preload(currentIndex - 1);
      }

      function onKeydown(e: KeyboardEvent) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowRight') show(currentIndex + 1);
        else if (e.key === 'ArrowLeft') show(currentIndex - 1);
      }

      function open(i: number) {
        lastFocused = document.activeElement as HTMLElement | null;
        root.classList.add('is-open');
        root.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        show(i, true);
        closeBtn?.focus();
        document.addEventListener('keydown', onKeydown);
      }

      function close() {
        root.classList.remove('is-open');
        root.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        lastFocused?.focus();
      }

      tiles.forEach((tile) => {
        tile.addEventListener('click', () => {
          const idx = Number(tile.dataset.index ?? '0');
          open(idx);
        });
      });

      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => show(currentIndex - 1));
      nextBtn?.addEventListener('click', () => show(currentIndex + 1));
      imgEl.addEventListener('contextmenu', (e) => e.preventDefault());
      imgEl.addEventListener('dragstart', (e) => e.preventDefault());
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .photo-grid {
    display: grid;
    gap: 0.75rem;
  }

  .photo-tile {
    all: unset;
    cursor: zoom-in;
    display: block;
    position: relative;
    background: var(--ink-soft);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    transition: transform 0.35s ease;
  }

  .photo-tile:hover img,
  .photo-tile:focus-visible img {
    transform: scale(1.04);
  }

  .photo-tile-pending {
    cursor: default;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
  }

  .photo-tile-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.5rem 0.75rem;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    color: var(--paper);
    background: linear-gradient(to top, rgba(11, 11, 12, 0.75), transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .photo-tile:hover .photo-tile-caption,
  .photo-tile:focus-visible .photo-tile-caption {
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease;
  }

  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: var(--ink);
  }

  .lightbox-stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 6vw, 5rem);
    pointer-events: none;
  }

  .lightbox-stage img {
    pointer-events: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .lightbox-stage img.is-switching {
    opacity: 0;
    transform: scale(0.98);
  }

  .lightbox-btn {
    all: unset;
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--paper);
    background: rgba(26, 26, 29, 0.6);
    cursor: pointer;
    z-index: 2;
  }

  .lightbox-btn:hover,
  .lightbox-btn:focus-visible {
    color: var(--signal);
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox-prev {
    top: 50%;
    left: 1rem;
    transform: translateY(-50%);
  }

  .lightbox-next {
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
  }

  .lightbox-meta {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--t-meta);
    letter-spacing: 0.06em;
    color: var(--muted);
    pointer-events: none;
  }

  .lightbox-caption {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .lightbox-prev {
      left: 0.25rem;
    }
    .lightbox-next {
      right: 0.25rem;
    }
  }
</style>
