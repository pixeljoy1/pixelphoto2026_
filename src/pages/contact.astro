---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" surface="paper">
  <section class="page pt-40 pb-24 max-w-3xl">
    <p class="meta">Contact</p>
    <h1 class="mt-6 font-display font-light text-h1 tracking-menu leading-tight">
      Get in touch.
    </h1>
    <div class="mt-10 space-y-4 text-lg">
      <p>
        <span class="meta block mb-1">Email</span>
        <a
          href="mailto:pixeljoy@gmail.com"
          class="underline decoration-signal underline-offset-4"
        >
          pixeljoy@gmail.com
        </a>
      </p>
      <p>
        <span class="meta block mb-1">Location</span>
        Bengaluru, Karnataka, India
      </p>
      <p>
        <span class="meta block mb-1">Elsewhere</span>
        <a
          href="https://www.behance.net/pixeljoyfec5"
          class="underline decoration-signal underline-offset-4"
        >
          Behance
        </a>
      </p>
    </div>
  </section>
</Base>
