---
import Base from '../layouts/Base.astro';
---

<Base title="Prints" surface="paper">
  <section class="page pt-40 pb-24 max-w-3xl">
    <p class="meta">Prints</p>
    <h1 class="mt-6 font-display font-light text-h1 tracking-menu leading-tight">
      Prints available via Fizdi.
    </h1>
    <p class="mt-8 text-lg text-ink/80">
      Selected work is available as gallery-grade prints through Fizdi, who
      handle framing, size options, and shipping across India.
    </p>
    <p class="mt-10">
      <a
        href="https://www.fizdi.com/"
        class="inline-block border border-ink px-6 py-3 meta hover:bg-ink hover:text-paper transition-colors"
      >
        Visit Fizdi catalogue →
      </a>
    </p>
    <p class="mt-16 text-sm text-ink/60">
      For custom sizes or direct licensing outside the Fizdi range, contact
      <a href="mailto:pixeljoy@gmail.com" class="underline decoration-signal">pixeljoy@gmail.com</a>.
    </p>
  </section>
</Base>
