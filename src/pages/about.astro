---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="About" surface="paper">
  <section class="page pt-40 pb-16 max-w-3xl">
    <p class="meta">About</p>

    <div class="mt-6 flex flex-col sm:flex-row gap-10 sm:gap-12 items-start">
      <img
        src={`${base}/images/joydeep-portrait.jpg`}
        alt="Portrait of Joydeep Mitra"
        width="300"
        height="344"
        class="w-[clamp(180px,38vw,300px)] shrink-0 object-cover shadow-[0_24px_40px_-20px_rgba(11,11,12,0.4)]"
      />
      <div>
        <h1 class="font-display font-light text-h1 tracking-menu leading-tight">
          Joydeep Mitra
        </h1>
        <p class="mt-2 meta">Photographer · UX design leader · Bengaluru</p>

        <div class="mt-8 space-y-6 text-lg leading-relaxed">
          <p>
            Fifteen years of photography across wildlife, deep-sky astronomy,
            aviation, landscape, documentary, street and portrait — sustained
            alongside a principal design career.
          </p>
          <p>
            The archive spans work from 2010 to 2025, including the Kumbh Mela 2013
            documentary series, the Varanasi Print Pack, deep-sky exposures from
            Bengaluru's dark-sky retreats, and long-lens wildlife from Kabini and
            Ranganathittu.
          </p>
        </div>

        <p class="mt-8 meta">
          <a
            href="https://www.instagram.com/wildscapeexplorers/"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-signal underline-offset-4 hover:text-signal"
          >
            @wildscapeexplorers on Instagram
          </a>
        </p>
      </div>
    </div>

    <hr class="hairline my-16" />

    <h2 class="font-display font-semibold text-h2">Licensing</h2>
    <p class="mt-4">
      All images © Joydeep Mitra. All rights reserved unless otherwise noted.
      For editorial, print, or licensing enquiries please email
      <a href="mailto:pixeljoy@gmail.com" class="underline decoration-signal underline-offset-4">
        pixeljoy@gmail.com</a
      >.
    </p>
  </section>
</Base>
