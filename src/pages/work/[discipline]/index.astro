---
import Base from '../../../layouts/Base.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { DISCIPLINES } from '../../../data/disciplines';
import { getDiscipline } from '../../../data/library';

export function getStaticPaths() {
  return DISCIPLINES.map((d) => ({ params: { discipline: d.key } }));
}

const { discipline } = Astro.params;
const summary = getDiscipline(discipline as any);
if (!summary) throw new Error(`Unknown discipline: ${discipline}`);

const yearSpan = (from?: number, to?: number) =>
  from && to ? (from === to ? `${from}` : `${from} — ${to}`) : '—';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const order = DISCIPLINES.map((d) => d.key);
---

<Base title={summary.discipline.label} surface="ink">
  <div id="discipline-feed">
    <div class="discipline-block" data-discipline={discipline}>
      <section class="page pt-40 pb-12 discipline-header">
        <p class="meta">
          <a href={`${base}/`} class="hover:text-signal">Home</a> ·
          {summary.discipline.label}
        </p>
        <h1 class="mt-6 font-display font-light text-h1 tracking-menu leading-none">
          {summary.discipline.label}
        </h1>
        <p class="mt-4 meta tabular-nums">
          {summary.frameCount} frames &nbsp;·&nbsp; {yearSpan(summary.yearFrom, summary.yearTo)}
        </p>
        <p class="mt-8 max-w-2xl text-muted">{summary.discipline.blurb}</p>
      </section>

      {
        summary.frameCount === 0 ? (
          <section class="page pb-24">
            <div class="border border-rule p-10 text-center">
              <p class="meta text-signal">Empty</p>
              <p class="mt-3 text-muted">
                No frames from this discipline have been approved for publish yet.
              </p>
            </div>
          </section>
        ) : (
          <section class="page pb-24 space-y-16">
            {summary.sets.map((set) => (
              <div>
                <div class="sticky top-0 z-10 bg-ink/90 backdrop-blur py-3 flex items-baseline justify-between border-b border-rule">
                  <a
                    href={`${base}/work/${summary.discipline.key}/${set.slug}`}
                    class="font-display font-semibold text-h2 hover:text-signal"
                  >
                    {set.name}
                  </a>
                  <span class="meta tabular-nums">
                    {set.frameCount} frames &nbsp;·&nbsp; {set.year ?? '—'}
                  </span>
                </div>
                <div class="mt-6">
                  <Lightbox
                    images={set.rows.map((row) => ({
                      fileId: row.fileId,
                      alt: row.altText || row.title || row.fileName,
                      caption: row.caption || row.title,
                    }))}
                  />
                </div>
              </div>
            ))}
          </section>
        )
      }
    </div>
  </div>

  <div id="feed-sentinel" aria-hidden="true"></div>

  <div id="feed-end" class="page pb-32 hidden" data-feed-end>
    <div class="border-t border-rule pt-10 text-center">
      <p class="meta text-signal">End of the archive</p>
      <p class="mt-3 text-muted">
        You&rsquo;ve scrolled through every discipline.
        <a href={`${base}/`} class="underline decoration-signal underline-offset-4">Back to home</a>
      </p>
    </div>
  </div>

  <script define:vars={{ base, order, startKey: discipline }}>
    const feed = document.getElementById('discipline-feed');
    const feedEnd = document.getElementById('feed-end');
    const sentinel = document.getElementById('feed-sentinel');
    const startIndex = order.indexOf(startKey);
    let cursor = startIndex;
    let loading = false;
    let finished = order.length <= 1 || startIndex === -1;

    function buildUrl(key) {
      return `${base}/work/${key}/`;
    }

    function revealEnd() {
      feedEnd?.classList.remove('hidden');
    }

    async function loadNext() {
      if (loading || finished) return;
      loading = true;
      cursor = (cursor + 1) % order.length;
      if (cursor === startIndex) {
        finished = true;
        loading = false;
        revealEnd();
        return;
      }
      const key = order[cursor];
      try {
        const res = await fetch(buildUrl(key));
        if (!res.ok) throw new Error(`status ${res.status}`);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const block = doc.querySelector('.discipline-block');
        if (!block) throw new Error('missing .discipline-block');
        const imported = document.importNode(block, true);
        imported.querySelectorAll('script').forEach((s) => {
          if (s.type !== 'application/json') s.remove();
        });
        const header = imported.querySelector('.discipline-header');
        if (header) {
          header.classList.remove('pt-40');
          header.classList.add('pt-24', 'mt-24', 'border-t', 'border-rule');
        }
        feed?.appendChild(imported);
        document.dispatchEvent(new Event('astro:page-load'));
      } catch (err) {
        finished = true;
      } finally {
        loading = false;
      }
    }

    async function maybeLoadMore() {
      if (loading || finished || !sentinel) return;
      const rect = sentinel.getBoundingClientRect();
      if (rect.top > window.innerHeight + 1200) return;
      await loadNext();
      requestAnimationFrame(maybeLoadMore);
    }

    if (sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) maybeLoadMore();
        },
        { rootMargin: '1200px 0px 1200px 0px' },
      );
      observer.observe(sentinel);
    }
  </script>
</Base>
