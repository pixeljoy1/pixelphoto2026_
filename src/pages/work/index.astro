---
import Base from '../../layouts/Base.astro';
import DisciplineIndex from '../../components/DisciplineIndex.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Work" surface="ink">
  <section class="page pt-40 pb-16">
    <p class="meta">
      <a href={`${base}/`} class="hover:text-signal">Home</a> · Work
    </p>
    <h1 class="mt-6 font-display font-light text-h1 tracking-menu leading-none">
      Nine disciplines. One archive.
    </h1>
  </section>
  <section class="page pb-24">
    <DisciplineIndex />
  </section>
</Base>
