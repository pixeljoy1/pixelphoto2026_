---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" surface="ink">
  <section class="page pt-40 pb-24">
    <p class="meta text-signal">404</p>
    <h1 class="mt-6 font-display font-light text-h1 tracking-menu leading-none">
      Not found.
    </h1>
    <p class="mt-6 text-muted">
      That page does not exist. Try
      <a
        href={`${import.meta.env.BASE_URL}/`}
        class="underline decoration-signal underline-offset-4"
      >
        home
      </a>
      or
      <a
        href={`${import.meta.env.BASE_URL}/work`}
        class="underline decoration-signal underline-offset-4"
      >
        work
      </a>.
    </p>
  </section>
</Base>
